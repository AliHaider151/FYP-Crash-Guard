MODEL_PATH=models/best-train-2.pt
APP_NAME=Crash Guard
# Set this to the full service-account JSON; wrap a multiline value in single quotes.
# In Vercel or another host, set it as a private environment variable instead.
FIREBASE_SERVICE_ACCOUNT_JSON=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional secondary incident verification using AMD DeepSeek Vision.
AMD_API_KEY=
AMD_API_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
INCIDENT_VERIFICATION_ENABLED=true
INCIDENT_VERIFICATION_MODEL=DeepSeek-V4-Flash-Vision-Exp
INCIDENT_VERIFICATION_FRAME_COUNT=8
INCIDENT_VERIFICATION_TIMEOUT_SECONDS=45